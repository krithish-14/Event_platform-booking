# ─────────────────────────────────────────────────────────────
# JOD Events Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# MANUAL ACTION REQUIRED before production: rotate every live secret
# (database password, JWT key, file encryption key, admin password,
# Google client secret, SMTP password). Do not reuse values from git
# history, chat, or local development. Do not put real secrets in this file.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:CHANGE_ME@localhost:5432/jod_events

# ── JWT Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts ID documents and images stored in the database.
FILE_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_FILE_ENCRYPTION_KEY

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── OAuth 2.0 Settings ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://127.0.0.1:5500/login.html

# ── Admin seed (required; no default password in code) ────────
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_USERNAME=jod_admin
# Set true only for first local seed / password reset from .env
ADMIN_SYNC_PASSWORD=false
PUBLIC_APP_URL=http://127.0.0.1:5500

# Optional SMTP for password reset and OTP emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=JOD Events <noreply@jodevents.com>
