# ─────────────────────────────────────────────────────────────
# JOD Events Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://jod_user:jod_password@db:5432/jod_events

# ── JWT Security ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts ID documents and images stored in the database.
# Use a dedicated random value in production (do not reuse across environments).
FILE_ENCRYPTION_KEY=change-this-to-a-long-random-file-encryption-key

# ── App Settings ──────────────────────────────────────────────
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500

# ── AI Integration (future) ───────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ── OAuth 2.0 Settings ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5500/login.html

# ── Admin QR portal ───────────────────────────────────────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_USERNAME=jod_admin
PUBLIC_APP_URL=http://127.0.0.1:5500

# Optional SMTP for ticket emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=JOD Events <noreply@jodevents.com>

# Optional WhatsApp Cloud API or Twilio. Without these, Generate QR opens a WhatsApp chat link.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


 