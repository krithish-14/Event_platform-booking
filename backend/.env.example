# ─────────────────────────────────────────────────────────────
# JOD Events Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://jod_user:jod_password@db:5432/jod_events

# ── JWT Security ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App Settings ──────────────────────────────────────────────
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500

# ── AI Integration (future) ───────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
 