# ─────────────────────────────────────────────────────────────
# JOD Events Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# MANUAL ACTION REQUIRED before production: rotate every live secret
# (database password, JWT key, file encryption key, admin password,
# Google client secret, SMTP password). Do not reuse values from git
# history, chat, or local development. Do not put real secrets in this file.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local only. Never point this at production RDS — live login/signup uses EC2 + RDS.
DATABASE_URL=postgresql+psycopg://USER:CHANGE_ME@localhost:5432/jod_events

# ── JWT Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
# Algorithm is hard-coded to HS256 in code; do not rely on this for security.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=jod-events
JWT_AUDIENCE=jod-events-api

# Encrypts ID documents and images stored in the database.
FILE_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_FILE_ENCRYPTION_KEY

# ── App Settings ──────────────────────────────────────────────
# Use APP_ENV=development locally. Production must set APP_ENV=production and DEBUG=False.
APP_ENV=development
DEBUG=False
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── Google Identity Services (ID token / credential flow) ──
# Required. Authorized JavaScript origins only — not a redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Not used by GIS credential login. Keep only if something else still needs it.
# GOOGLE_CLIENT_SECRET=CHANGE_ME
# Do not set GOOGLE_REDIRECT_URI for GIS. login.html is the page, not an OAuth redirect.

# ── Cloudflare Turnstile (email/password signup only) ──
# Site key is public and returned by GET /api/auth/turnstile/config.
# Secret stays on the server. Never put the secret in HTML or JavaScript.
# Local official test keys: site 1x00000000000000000000AA
# secret 1x0000000000000000000000000000000AA
# Production: create a Managed widget for jodevents.com, www.jodevents.com,
# localhost, and 127.0.0.1. Production hostnames must not include localhost.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# CLOUDFLARE_TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Browser Maps JavaScript key (HTTP referrer restricted). Never put a server-only secret here.
# Enable Maps JavaScript API + Places API + Geocoding API. Restrict to jodevents.com and localhost.
# GOOGLE_MAPS_API_KEY=

# ── Admin seed (required; no default password in code) ────────
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_USERNAME=jod_admin
# Set true only for first local seed / password reset from .env
ADMIN_SYNC_PASSWORD=false
PUBLIC_APP_URL=http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500
AUTH_EXPOSE_TOKEN=false
AUTH_CSRF=false
# Production should set AUTH_COOKIE_DOMAIN=.jodevents.com so the site can use API cookies.
# AUTH_COOKIE_DOMAIN=.jodevents.com

# During FILE_ENCRYPTION_KEY rotation only:
# FILE_ENCRYPTION_KEY_PREVIOUS=

# ── Cloudflare R2 (public host event images) ─────────────────
# Custom domain should serve the bucket, matching existing files like
# https://assets.jodevents.com/images/JOD%20Logo.png
# Host uploads are stored as images/uploads/{type}/{event}/{id}.jpg
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://assets.jodevents.com/images
# If assets.jodevents.com already maps to the images/ folder, set R2_OBJECT_PREFIX empty.
# R2_OBJECT_PREFIX=images

# Optional SMTP for password reset, OTP, and QR ticket emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=JOD Events <noreply@jodevents.com>

# Optional WhatsApp ticket delivery (Meta Cloud API or Twilio). Without these, a wa.me link is logged/returned.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Same string as Meta Developer Console → WhatsApp → Configuration → Verify token
# WHATSAPP_VERIFY_TOKEN=
# Callback URL: https://api.jodevents.com/api/whatsapp/webhook
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# ── Razorpay Standard Checkout (test keys for local; use live keys in production) ──
# KEY_SECRET must never be exposed to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
