# Staging environment template. Copy to .env.staging (gitignored).
# Use a separate database and sandbox credentials — never production secrets.

APP_ENV=production
DEBUG=False

POSTGRES_USER=jod
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
POSTGRES_DB=jod_events_staging
DATABASE_URL=postgresql+psycopg://jod:CHANGE_ME_STAGING_DB_PASSWORD@postgres:5432/jod_events_staging

FRONTEND_URL=https://staging.YOUR_DOMAIN.com
PUBLIC_APP_URL=https://staging.YOUR_DOMAIN.com
ALLOWED_ORIGINS=https://staging.YOUR_DOMAIN.com
ALLOWED_HOSTS=staging.YOUR_DOMAIN.com

SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY
FILE_ENCRYPTION_KEY=CHANGE_ME_STAGING_FILE_ENCRYPTION_KEY
AUTH_COOKIE_SECURE=true
ADMIN_SYNC_PASSWORD=false

ADMIN_EMAIL=CHANGE_ME_STAGING_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASSWORD
ADMIN_USERNAME=jod_admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.YOUR_DOMAIN.com/login.html

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RATE_LIMIT_ENABLED=true
ENABLE_DOCS=false
