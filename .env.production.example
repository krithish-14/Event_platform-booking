# Production environment template. Copy to .env.production (gitignored) and fill values.
# NEVER put real secrets in this file or commit .env.production.
# Generate secrets with: python backend/scripts/generate_secrets.py

APP_ENV=production
DEBUG=False

# PostgreSQL used by the API container (must match docker-compose postgres service)
POSTGRES_USER=jod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=jod_events
DATABASE_URL=postgresql+psycopg://jod:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/jod_events

# Public HTTPS origin (no trailing slash)
FRONTEND_URL=https://YOUR_DOMAIN.com
PUBLIC_APP_URL=https://YOUR_DOMAIN.com
ALLOWED_ORIGINS=https://YOUR_DOMAIN.com,https://www.YOUR_DOMAIN.com
ALLOWED_HOSTS=YOUR_DOMAIN.com,www.YOUR_DOMAIN.com

SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
FILE_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_FILE_ENCRYPTION_KEY
# Previous key only during a planned FILE_ENCRYPTION_KEY rotation
# FILE_ENCRYPTION_KEY_PREVIOUS=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=true
AUTH_CSRF=true
AUTH_EXPOSE_TOKEN=false
# Share auth/CSRF cookies across apex + api subdomain (required for host dashboard saves)
AUTH_COOKIE_DOMAIN=.jodevents.com
ADMIN_SYNC_PASSWORD=false

ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_USERNAME=jod_admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN.com/login.html

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=JOD Events <noreply@YOUR_DOMAIN.com>

# Cloudflare R2 for public host images (banner, card, gallery, sponsors)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://assets.jodevents.com/images
# R2_OBJECT_PREFIX=images

RATE_LIMIT_ENABLED=true
ENABLE_DOCS=false

# Razorpay Standard Checkout (live keys in production; never expose KEY_SECRET to the frontend)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
